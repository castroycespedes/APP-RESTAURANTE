{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@restaurante/types": ["packages/types/src/index.ts"],
      "@restaurante/ui": ["packages/ui/src/index.ts"],
      "@restaurante/config": ["packages/config/src/index.ts"]
    }
  }
}
